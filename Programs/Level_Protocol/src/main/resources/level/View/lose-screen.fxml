<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="rootPane" prefHeight="525.0" prefWidth="825.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="level.Controllers.EndGame">
   <children>
      <Region prefHeight="500.0" prefWidth="800.0" styleClass="displayScreen" stylesheets="@win-lose-screen.css" />
      <VBox alignment="CENTER" spacing="50">
          <Text text="You Lose">
            <font>
               <Font name="Times New Roman" size="60.0" />
            </font>
          </Text>
          <Button onAction="#handlePlayAgain" stylesheets="@win-lose-screen.css" text="Play Again" />
          <Button onAction="#handleExitButton" stylesheets="@win-lose-screen.css" text="Exit" />
      </VBox>
   </children>
</StackPane>
