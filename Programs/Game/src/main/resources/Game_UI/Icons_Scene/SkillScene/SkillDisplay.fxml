<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<HBox fx:id="background" alignment="CENTER_LEFT" prefHeight="150.0" prefWidth="900.0" spacing="100.0" style="-fx-border-radius: 20;" stylesheets="@SkillDisplay.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="EditorUI.EquipmentPane">
   <children>
      <HBox fx:id="sideBoard" alignment="CENTER_LEFT" prefHeight="150.0" styleClass="sideBoard">
         <children>
            <Pane prefHeight="150.0" prefWidth="500.0">
               <children>
                  <Text fx:id="text" layoutX="10.0" layoutY="70.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Attack" />
               </children>
            </Pane>
            <ImageView fx:id="skillIcon" fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@Icons/Empty_Skill.png" />
               </image>
               <HBox.margin>
                  <Insets left="25.0" right="25.0" />
               </HBox.margin>
            </ImageView>
         </children>
      </HBox>
      <Button fx:id="equipButton" mnemonicParsing="false" onAction="#equipSkill" prefHeight="60.0" prefWidth="150.0" style="-fx-background-radius: 10; -fx-background-color: #E6E6E6;" styleClass="dropEffect" text="Removed">
         <font>
            <Font name="Verdana" size="18.0" />
         </font>
         <HBox.margin>
            <Insets />
         </HBox.margin>
      </Button>
   </children>
   <padding>
      <Insets right="20.0" />
   </padding>
</HBox>
