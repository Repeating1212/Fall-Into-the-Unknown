<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane fx:id="rootPane" maxHeight="675.0" maxWidth="1200.0" prefHeight="675.0" prefWidth="1200.0" style="-fx-background-color: #1A1A1A;" stylesheets="@StartScene.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Game_UI.StartScenes.StartScene">
   <children>
      <ImageView fx:id="fallingGirl" fitWidth="700.0" layoutX="45.0" layoutY="41.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../Picture/StartScene/Background.png" />
         </image>
      </ImageView>
      <Button layoutX="875.0" layoutY="120.0" mnemonicParsing="false" onAction="#loadGameScene" styleClass="main-button" text="Play Game" />
      <Button layoutX="875.0" layoutY="299.0" mnemonicParsing="false" onAction="#loadGameDesigner" styleClass="main-button" text="Game Designer" />
      <Button layoutX="875.0" layoutY="482.0" mnemonicParsing="false" onAction="#quitGame" styleClass="main-button" text="Quit" />
      <AnchorPane layoutX="201.0" layoutY="525.0" prefHeight="100.0" prefWidth="200.0">
         <children>
            <Text fill="WHITE" layoutX="193.0" layoutY="87.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Summer Game Development">
               <font>
                  <Font size="24.0" />
               </font>
               <styleClass>
                  <String fx:value="subtitle-text" />
                  <String fx:value="text" />
               </styleClass>
            </Text>
            <Text fill="WHITE" layoutY="49.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Fall Into The Unknown">
               <font>
                  <Font size="48.0" />
               </font>
               <styleClass>
                  <String fx:value="title-text" />
                  <String fx:value="text" />
               </styleClass>
            </Text>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
