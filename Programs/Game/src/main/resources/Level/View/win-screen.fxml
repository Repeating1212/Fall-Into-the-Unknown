<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="rootPane" prefHeight="525.0" prefWidth="825.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Level.Controllers.WinController">
   <children>
      <Region prefHeight="500.0" prefWidth="800.0" styleClass="displayScreen" stylesheets="@win-lose-screen.css" />
      <VBox alignment="CENTER" spacing="30.0">
          <Text text="Victory!">
            <font>
               <Font name="Verdana" size="60.0" />
            </font>
            <VBox.margin>
               <Insets bottom="20.0" />
            </VBox.margin>
          </Text>
         <HBox alignment="CENTER">
            <children>
               <Text fx:id="coinLabel" text="0">
                  <font>
                     <Font name="Verdana" size="14.0" />
                  </font>
               </Text>
               <ImageView fitHeight="150.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../../picture/Coin_Image.png" />
                  </image>
               </ImageView>
            </children>
         </HBox>
         <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="50.0">
            <children>
                <Button onAction="#handlePlayAgain" stylesheets="@win-lose-screen.css" text="Play Again" />
                <Button onAction="#handleExitButton" stylesheets="@win-lose-screen.css" text="Exit" />
            </children>
         </HBox>
      </VBox>
   </children>
</StackPane>
