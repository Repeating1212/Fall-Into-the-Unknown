<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="PauseScreen" prefHeight="675.0" prefWidth="1200.0" styleClass="background" stylesheets="@../CssFile/pause-screen.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Level.BaseLevel.Controllers.PauseController">
   <center>
      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="525.0" prefWidth="825.0" spacing="30.0" styleClass="displayBoard">
          <Text text="Pause Game">
            <font>
               <Font name="Verdana" size="60.0" />
            </font>
          </Text>
          <Button onAction="#handleResumeButton" text="Resume" />
          <Button onAction="#handleExitButton" text="Exit" />
         <Button onAction="#handlePlayAgain" text="Restart" />
      </VBox>
   </center>
</BorderPane>
