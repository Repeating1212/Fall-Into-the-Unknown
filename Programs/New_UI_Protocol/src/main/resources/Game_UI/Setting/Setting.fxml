<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Rectangle?>

<StackPane fx:id="SettingPane" stylesheets="@Setting.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Game_UI.Controller.Setting">
   <children>
      <Pane style="-fx-background-color: Black; -fx-opacity: 0.2;" />
      <BorderPane prefHeight="675.0" prefWidth="1200.0">
         <center>
            <StackPane BorderPane.alignment="CENTER">
               <children>
                  <Rectangle arcHeight="30.0" arcWidth="30.0" fill="#d9d9d9" height="270.0" stroke="WHITE" strokeType="INSIDE" strokeWidth="3.0" styleClass="shadow-rectangle" width="480.0" />
                  <AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="270.0" prefWidth="480.0">
                     <children>
                        <HBox alignment="CENTER" layoutX="90.0" layoutY="182.0" spacing="100.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#handleClose" styleClass="main-button" text="Close">
                                 <padding>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </padding>
                              </Button>
                              <Button mnemonicParsing="false" onAction="#handleQuit" styleClass="main-button" text="Quit">
                                 <padding>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </padding>
                              </Button>
                           </children>
                        </HBox>
                     </children>
                  </AnchorPane>
               </children>
            </StackPane>
         </center>
      </BorderPane>
   </children>
</StackPane>
